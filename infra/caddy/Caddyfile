# RAPTOR Gateway — Caddy
# Yalnız host bind 127.0.0.1:<port> (docker-compose), tek origin altında API+UI.

:80 {
  encode gzip

  # API / SSE / webhook
  @api {
    path /api/* /health/* /webhooks/* /events*
  }
  handle @api {
    reverse_proxy raptor-api:8000 {
      flush_interval -1
    }
  }

  # UI (api container'ındaki statik dist)
  handle {
    reverse_proxy raptor-api:8000 {
      flush_interval -1
    }
  }

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }
}