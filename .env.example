# =========================================================
# RAPTOR Agentic Observatory — örnek ortam dosyası
# Bu dosya YALNIZCA değişken adları ve GÜVENLİ placeholder içerir.
# Gerçek değerler ASLA buraya yazılmaz; ./secrets/raptor-observatory/app.env kullanılır.
# Kopyala: cp .env.example .env   (geliştirme tests için) — production secrets ayrıdır.
# =========================================================

# --- Genel ---
APP_ENV=development        # development | production
APP_TIMEZONE=UTC
SCHEMA_VERSION=1

# --- Veritabanı (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=raptor
POSTGRES_DB=raptor
POSTGRES_PASSWORD=CHANGE_ME          # production'da secret dosyasından gelir
DATABASE_URL=postgresql+psycopg://raptor:CHANGE_ME@raptor-postgres:5432/raptor

# --- Redis 7 (job queue) ---
REDIS_URL=redis://raptor-redis:6379/0

# --- API / Gateway ---
API_PORT=8000
GATEWAY_HOST=0.0.0.0

# --- Güvenlik ---
JWT_SECRET=CHANGE_ME                 # 64 hex karakter
SESSION_ENCRYPTION_MASTER_KEY=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
# Cloudflare Access (production) — origin JWT doğrulaması
CLOUDFLARE_ACCESS_AUD=CHANGE_ME      # Access app AUD tag
CLOUDFLARE_ACCESS_CERT_PEM_PATH=/run/secrets/access-cert.pem

# --- Telegram ---
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_ALLOWED_USER_IDS=            # virgülle ayrılmış numeric ID; '*' veya boş = erişim kapalı
TELEGRAM_GROUP_ENABLED=false

# --- LLM Provider (OpenAI-compatible) ---
LLM_PROVIDER=mock                    # mock | openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=CHANGE_ME

# --- Agent sınırları (guardrail) ---
RUN_MAX_ITERATIONS=40
RUN_MAX_TOOL_CALLS=80
RUN_MAX_WALL_SECONDS=900
RUN_MAX_TOKEN_BUDGET=200000
RUN_MAX_COST_BUDGET=5.0

# --- Connector SSRF ---
CONNECTOR_ALLOWED_HOSTS=             # boş = alleen deny-list (loopback/rfc1918/metadata)
CONNECTOR_MAX_RESPONSE_BYTES=1048576
CONNECTOR_MAX_REDIRECTS=3

# --- Technocore ---
TECHNOCORE_BASE_URL=https://technocore.chat
TECHNOCORE_ROOM_CLAIM=dm-topic-observatory

# --- Frontend (browser'a açıktır) ---
VITE_API_BASE=/api
VITE_WSS_BASE=/events